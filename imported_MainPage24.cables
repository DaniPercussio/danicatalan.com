0405768754}},"portsIn":[{"name":"method index","value":7},{"name":"method","value":"opacity"}]},{"opId":"650baeb1-db2d-4781-9af6-ab4e9d4277be","id":"uulp5rc93","uiAttribs":{"translate":{"x":-66.85084864519554,"y":-209.09488416924103}},"portsIn":[{"name":"posX","value":0},{"name":"posY","value":-0.28},{"name":"posZ","value":0},{"name":"scale","value":1},{"name":"rotX","value":0},{"name":"rotY","value":0},{"name":"rotZ","value":0}],"portsOut":[{"name":"trigger","links":[{"portIn":"render","portOut":"trigger","objIn":"ywu6skpwc","objOut":"uulp5rc93"}]}],"objName":"Ops.Graphics.Transform"},{"opId":"6468b7c1-f63e-4db4-b809-4b203d27ead3","id":"kwrecqsc2","uiAttribs":{"translate":{"x":499.701168555757,"y":-1923.9860962729047}},"portsIn":[{"name":"value","value":"<div class=\"scroll-fade\">\r\n    <div class=\"scroll-content\" style=\"white-space: pre-line;\">\r\n        \r\n\r\nI have been chasing that vibration ever since. Sometimes it hides in the warmth of wood, in the echo of a marimba bar that still resonates after the mallet has left it. Sometimes it hides in silence — in that mysterious, weightless pause where the music seems to hold its breath and wait for something unnamed.\r\n\r\nI often wonder what it means to belong to sound. My journey has taken me from the narrow streets of Onda to the classrooms of Valencia, from the vastness of Germany’s grey skies to the strange intimacy of a dark theater before the lights come up. Yet everywhere I go, I carry the same question: what is it that music really says, when it stops trying to impress and begins to confess?\r\n\r\nPlaying percussion taught me to think with my hands, to listen not only outward but inward. The vibraphone, especially, feels like an instrument of memory — each note fades, yet leaves a trace, like breath on glass. Perhaps that’s what draws me to theater: the way it allows music to dissolve into human gesture, into fragility, into something transient and true.\r\n\r\nWhen I compose for the stage, I no longer think of melody or harmony first. I think of presence — of a pulse beneath words, of the secret rhythm of an actor’s inhale. The music becomes a mirror, sometimes reflecting, sometimes contradicting, always listening.\r\n\r\nThere are days when I miss the certainty of scores and competitions, the illusion that art can be measured. But more and more, I find beauty in what escapes control — in the accidental, the improvised, the imperfect. The mallet misses the center of the bar, and suddenly, a new color appears. Maybe that’s where truth hides: in the deviation, in the human tremor that no technique can erase.\r\n\r\nI’ve come to believe that to make music is to stand between sound and silence, to accept that we are both the resonance and the fading echo. Every performance, every note, is an act of disappearance — and yet, somehow, in disappearing, it leaves a trace of who we are.\r\n\r\n        <!-- EXTRA SPACE AT THE END -->\r\n        <div style=\"height: 5px;\"></div>\r\n    </div>\r\n</div>\r\n"},{"name":"Syntax index","value":3},{"name":"Syntax","value":"html"}],"portsOut":[{"name":"Result","links":[{"portIn":"Text","portOut":"Result","objIn":"yzi6kb4wj","objOut":"kwrecqsc2"}]}],"objName":"Ops.String.StringEditor"},{"opId":"c179aa0e-b558-4130-8c2d-2deab2919a07","id":"c546dpdqf","uiAttribs":{"translate":{"x":499.701168555757,"y":-1789.1968085957812}},"portsIn":[{"name":"Property","value":"left"},{"name":"Value Suffix","value":"%"}],"portsOut":[{"name":"HTML Element","links":[{"portIn":"Element","portOut":"HTML Element","objIn":"h4ptjp708","objOut":"c546dpdqf"}]}]},{"opId":"b7e1635c-b5c0-43e1-be03-2f137e6e61ea","id":"1vzf9g3c3","uiAttribs":{"title":"Name","translate":{"x":-701.9929460436363,"y":-2050.0528847654127},"disabled":false},"portsIn":[{"name":"Element index","value":0},{"name":"Element","value":"Input"},{"name":"Type index","value":0},{"name":"Type","value":"Text"},{"name":"Default Value","value":""},{"name":"Placeholder","value":"your name"},{"na